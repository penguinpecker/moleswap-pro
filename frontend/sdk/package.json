{
  "name": "@moleswap/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for MoleSwap DEX on PushChain — swap tokens, create pools, add liquidity",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --clean --no-dts && tsc --declaration --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "moleswap", "dex", "pushchain", "swap", "defi", "amm", "uniswap-v3", "web3", "token-launcher"
  ],
  "author": "MoleSwap <penguinpecker1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/penguinpecker/moleswap",
    "directory": "sdk"
  },
  "homepage": "https://moleswap-eight.vercel.app/docs",
  "bugs": {
    "url": "https://github.com/penguinpecker/moleswap/issues"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
