# Robinhood Chain RPC AS THE BROWSER SEES IT. This is public by construction — anything prefixed
# NEXT_PUBLIC_ is inlined into the client bundle at build time — so it must be a KEYLESS endpoint or
# a proxy of ours, NEVER a keyed provider URL. A provider URL published to users is a published API
# key: on 2026-08-24 a keyed Alchemy URL was sitting in five shipped JavaScript chunks on the live
# site, exactly as configured.
#
# Robinhood has no proxy yet, so this stays keyless. Arc has one (/rpc/v1/arc) and keeps its key in
# the server-only ARC_RPC_UPSTREAMS below. Giving Robinhood the same treatment needs lib/rpc/proxy.ts
# and policy.ts parameterised by chain first — they answer eth_chainId from Arc's constant as a last
# resort, so a copied route reports Arc's chain id while forwarding reads to Robinhood.
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Supabase (leaderboard, quests, user data) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: privileged writes in /api/quests/verify-social.
# Falls back to the anon key when unset. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WalletConnect (optional — the QR/mobile-wallet connector is enabled only when set)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# Site
NEXT_PUBLIC_SITE_URL=https://www.moleswap.com

# ---------------------------------------------------------------------------
# Arc mainnet (5042) RPC — the upstreams behind our public /rpc/v1/arc endpoint.
#
# SERVER-ONLY ON PURPOSE. Never prefix these with NEXT_PUBLIC_. A provider URL
# that reaches the browser is a published API key: anyone can spend it, and when
# it is exhausted your users are the ones who stop being able to swap.
#
# Comma-separated and ORDERED — the first is primary, later entries are tried
# only when an earlier one fails at the infrastructure level (a reverted call is
# an answer, not a failure, and never triggers a retry). Put a keyed endpoint you
# control first; keep a keyless one last so an expired key is not a total outage.
# Unset falls back to the keyless default in lib/rpc/upstreams.ts.
ARC_RPC_UPSTREAMS=https://arc-mainnet.g.alchemy.com/v2/your-key,https://rpc.arc-scan.org

# Requests per minute per IP on /rpc/v1/arc (a batch counts as its length). Default 600.
ARC_RPC_RATE_LIMIT=600

# Optional block explorer reported by the endpoint's GET descriptor. Left unset
# deliberately: Arc has no official public explorer, and advertising an anonymously
# operated one would put MoleSwap's name behind a site we do not control.
# ARC_BLOCK_EXPLORER=

# Google Analytics (optional — analytics stay off when unset)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Legacy XP/Twitter backend used by /earn-xp and /connect-twitter
# (optional — defaults to http://localhost:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000
