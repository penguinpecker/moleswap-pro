# Robinhood Chain RPC (optional — defaults to the public RPC when unset)
NEXT_PUBLIC_RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Supabase (leaderboard, quests, user data) — REQUIRED
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: privileged writes in /api/quests/verify-social.
# Falls back to the anon key when unset. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WalletConnect (optional — the QR/mobile-wallet connector is enabled only when set)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-project-id

# Site
NEXT_PUBLIC_SITE_URL=https://www.moleswap.com

# Google Analytics (optional — analytics stay off when unset)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Legacy XP/Twitter backend used by /earn-xp and /connect-twitter
# (optional — defaults to http://localhost:5000)
NEXT_PUBLIC_API_URL=http://localhost:5000
